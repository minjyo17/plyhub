{
  "name": "playhub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "backend:up": "docker compose up -d --build --wait --wait-timeout 120",
    "backend:down": "docker compose down",
    "backend:logs": "docker compose logs -f nakama postgres",
    "backend:status": "docker compose ps",
    "backend:check": "node scripts/check-backend.mjs",
    "backend:verify": "node scripts/check-backend.mjs --verify",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@heroiclabs/nakama-js": "^2.8.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.14"
  }
}
